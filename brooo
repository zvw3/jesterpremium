-- // AFK GRIND SYSTEM //
local function HoldEFor4Seconds(targetPart)
    local proximityPrompt = targetPart:FindFirstChildOfClass("ProximityPrompt", true)
    if proximityPrompt then
        fireproximityprompt(proximityPrompt)
        task.wait(4)
    else
        local VirtualInputManager = game:GetService("VirtualInputManager")
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(4)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
end

local function AFKGrindLoop()
    local brainFolder = workspace:WaitForChild("GameFolder"):WaitForChild("Brainrots")
    
    while AFKGrindEnabled do
        task.wait(0.5)
        
        if not AFKGrindEnabled or IsGrinding then continue end
        
        local targetModel = nil
        for _, rarity in ipairs({"Godly", "Celestial"}) do
            local rFolder = brainFolder:FindFirstChild(rarity)
            if rFolder then
                for _, model in pairs(rFolder:GetChildren()) do
                    if model:FindFirstChild("RootPart") then
                        targetModel = model
                        break
                    end
                end
            end
            if targetModel then break end
        end
        
        if targetModel and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            IsGrinding = true
            
            LocalPlayer.Character:PivotTo(targetModel.RootPart.CFrame + Vector3.new(0, 3, 0))
            task.wait(0.5)
            
            HoldEFor4Seconds(targetModel.RootPart)
            
            LocalPlayer.Character:PivotTo(CFrame.new(SPAWN_POS))
            task.wait(4)
            
            IsGrinding = false
        end
    end
end

-- // REFRESH FUNCTION //
local function Refresh()
    for _, row in pairs(UIPool) do 
        row.Visible = false 
    end
    for _, conn in pairs(TPConnections) do 
        conn:Disconnect() 
    end
    table.clear(TPConnections)

    local folder = workspace:FindFirstChild("GameFolder") and workspace.GameFolder:FindFirstChild("Brainrots")
    if not folder then return end
    
    local count = 1
    for _, rarity in ipairs({"Common", "Rare", "Epic", "Legendary", "Mythic", "Godly", "Celestial", "Secret"}) do
        local rFolder = folder:FindFirstChild(rarity)
        if rFolder then
            for _, model in pairs(rFolder:GetChildren()) do
                if (rarity == "Godly" or rarity == "Celestial") and model:FindFirstChild("RootPart") then
                    CreateESP(model.RootPart, rarity)
                end
                
                if ActiveFilters[rarity] and (SearchText == "" or string.find(string.lower(model.Name), string.lower(SearchText))) then
