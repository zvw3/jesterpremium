        btn.Indicator.BackgroundColor3 = state and THEME.Text or THEME.TextDim
        if IS_MOBILE then
            TweenService:Create(btn.Indicator, TweenInfo.new(0.2), {
                Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
            }):Play()
        else
            btn.Status.Text = state and "ON" or "OFF"
            btn.Status.TextColor3 = state and THEME.Success or THEME.TextDim
        end
    end
end

