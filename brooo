local function CreateESP(part, rarity)
    if not part:FindFirstChild("JesterESP") then
        local bg = Instance.new("BillboardGui", part)
        bg.Name = "JesterESP"
        bg.AlwaysOnTop = true
        bg.Size = UDim2.new(0, 100, 0, 30)
        bg.ExtentsOffset = Vector3.new(0, 3, 0)

        local txt = Instance.new("TextLabel", bg)
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.Text = "[" .. rarity:upper() .. "]"
        txt.TextColor3 = (rarity == "Celestial") and Color3.fromRGB(0, 200, 255) or Color3.fromRGB(255, 200, 0)
        txt.Font = Enum.Font.GothamBlack
        txt.TextSize = 14

        local Line = Instance.new("Beam", part)
        Line.Width0 = 0.2
        Line.Width1 = 0.2
        Line.Transparency = NumberSequence.new(0.5)
        Line.FaceCamera = true
        Line.Color = ColorSequence.new(txt.TextColor3)
        
        local A1 = Instance.new("Attachment", part)
        local A2 = Instance.new("Attachment", LocalPlayer.Character:WaitForChild("HumanoidRootPart"))
        Line.Attachment0 = A1
        Line.Attachment1 = A2
        
        task.spawn(function()
            while part and part.Parent do
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    A2.Parent = LocalPlayer.Character.HumanoidRootPart
                end
                task.wait(1)
            end
        end)
    end
end

