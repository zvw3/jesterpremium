function Refresh()
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    local folder = workspace:FindFirstChild("GameFolder") and workspace.GameFolder:FindFirstChild("Brainrots")
    if folder then
        for _, rarity in ipairs({"Common", "Rare", "Epic", "Legendary", "Mythic", "Godly", "Celestial", "Secret"}) do
            local f = folder:FindFirstChild(rarity)
            if f then for _, b in pairs(f:GetChildren()) do AddRow(b, rarity) end end
        end
    end
end

