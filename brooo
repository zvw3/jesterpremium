local function Refresh()
    for _, row in pairs(UIPool) do 
        row.Visible = false 
    end
    for _, conn in pairs(TPConnections) do 
        conn:Disconnect() 
    end
    table.clear(TPConnections)

    local folder = workspace:FindFirstChild("GameFolder") and workspace.GameFolder:FindFirstChild("Brainrots")
    if not folder then return end
    
    local count = 1
    for _, rarity in ipairs({"Common", "Rare", "Epic", "Legendary", "Mythic", "Godly", "Celestial", "Secret"}) do
        local rFolder = folder:FindFirstChild(rarity)
        if rFolder then
            for _, model in pairs(rFolder:GetChildren()) do
                if (rarity == "Godly" or rarity == "Celestial") and model:FindFirstChild("RootPart") then
                    CreateESP(model.RootPart, rarity)
                end
                
                if ActiveFilters[rarity] and (SearchText == "" or string.find(string.lower(model.Name), string.lower(SearchText))) then
                    local Row = UIPool[count]
                    if not Row then
                        Row = Instance.new("Frame"); Row.Size = UDim2.new(1,-5,0,45); Row.BackgroundColor3 = THEME.Element; Instance.new("UICorner", Row)
                        local Title = Instance.new("TextLabel", Row); Title.Name = "Title"; Title.Size, Title.Position, Title.TextColor3, Title.Font, Title.BackgroundTransparency, Title.TextXAlignment = UDim2.new(0.6,0,1,0), UDim2.new(0,10,0,0), THEME.Text, "GothamBold", 1, "Left"
                        local TP = Instance.new("TextButton", Row); TP.Name = "TPBtn"; TP.Size, TP.Position, TP.Text = UDim2.new(0,60,0,25), UDim2.new(1,-70,0.5,-12), "TP"; Instance.new("UICorner", TP); AddAnimatedGradient(TP)
                        UIPool[count] = Row
                    end
                    
                    Row.Parent = Scroll
                    Row.Title.Text = model.Name
                    Row.Visible = true

                    local targetModel = model
                    TPConnections[count] = Row.TPBtn.MouseButton1Click:Connect(function()
                        if targetModel and targetModel:FindFirstChild("RootPart") then
                            LocalPlayer.Character:PivotTo(targetModel.RootPart.CFrame + Vector3.new(0,3,0))
                        end
                    end)
                    
                    count = count + 1
                end
            end
        end
    end
end

