local function CreateFilterButton(name)
    local btn = Instance.new("TextButton", Sidebar)
    btn.Size = UDim2.new(0.85, 0, 0, 30)
    btn.BackgroundColor3 = THEME.Background
    btn.Text = name
    btn.TextColor3 = THEME.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = THEME.RedDark
    stroke.Thickness = 1

    btn.MouseButton1Click:Connect(function()
        ActiveFilters[name] = not ActiveFilters[name]
        if ActiveFilters[name] then
            Tween(stroke, {Color = THEME.Success})
            Tween(btn, {TextColor3 = THEME.Success})
        else
            Tween(stroke, {Color = THEME.Error})
            Tween(btn, {TextColor3 = THEME.TextDim})
        end
        Refresh()
    end)
    -- Init State
    if ActiveFilters[name] then 
        stroke.Color = THEME.Success
        btn.TextColor3 = THEME.Success 
    end
end

for _, f in ipairs({"Common", "Rare", "Epic", "Legendary", "Mythic", "Godly", "Celestial", "Secret"}) do CreateFilterButton(f) end

