VerifyBtn.MouseButton1Click:Connect(function()
    VerifyBtn.Text = "VERIFYING..."
    VerifyBtn.TextColor3 = THEME.TextDim
    
    local success, response = pcall(function() 
        return game:HttpGet(RAW_URL .. "?nocache=" .. tick()) 
    end)
    
    if success then
        local data = HttpService:JSONDecode(response)
        local key = KeyInput.Text:gsub("%s+", "")
        local found = false
        
        for _, k in pairs(data.keys) do 
            if k == key then found = true end 
        end
        
        if found and key:find(LocalPlayer.Name) then
            VerifyBtn.Text = "✓ VERIFIED"
            VerifyBtn.BackgroundColor3 = THEME.Success
            
            task.wait(0.5)
            
            TweenService:Create(LoginContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {
                Position = UDim2.new(0, 0, -1, 0)
            }):Play()
            
            Content.Visible = true
            Content.Position = UDim2.new(0, 0, 1, 60)
            TweenService:Create(Content, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {
                Position = UDim2.new(0, 0, 0, 60)
            }):Play()
            
            task.wait(0.5)
            Refresh()
            
            local brainFolder = workspace:WaitForChild("GameFolder"):WaitForChild("Brainrots")
            brainFolder.DescendantAdded:Connect(function() task.wait(0.1) Refresh() end)
            brainFolder.DescendantRemoving:Connect(function() task.wait(0.1) Refresh() end)
        else
            VerifyBtn.Text = "✗ INVALID KEY"
            VerifyBtn.BackgroundColor3 = THEME.Error
            task.wait(2)
            VerifyBtn.Text = "VERIFY KEY"
            VerifyBtn.BackgroundColor3 = THEME.Primary
            VerifyBtn.TextColor3 = THEME.Text
        end
    else
        VerifyBtn.Text = "✗ ERROR"
        VerifyBtn.BackgroundColor3 = THEME.Error
        task.wait(2)
        VerifyBtn.Text = "VERIFY KEY"
        VerifyBtn.BackgroundColor3 = THEME.Primary
        VerifyBtn.TextColor3 = THEME.Text
    end
end)

