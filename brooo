    task.wait(0.2)

    local function StripPlayer(char)
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("Accessory") or obj:IsA("Clothing") or obj:IsA("ShirtGraphic") or obj:IsA("BodyColors") then
                obj:Destroy()
            end
        end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then StripPlayer(p.Character) end
        p.CharacterAdded:Connect(StripPlayer)
    end

    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("PostProcessEffect") then v:Destroy() end
    end
