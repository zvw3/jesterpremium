local function CreateTab(name, icon, page)
    local isActive = page == Page_Teleports
    
    local Tab = Instance.new("TextButton", TabContainer)
    Tab.Name = name
    Tab.Size = IS_MOBILE and UDim2.new(0, 110, 1, -10) or UDim2.new(1, 0, 0, 45)
    Tab.BackgroundColor3 = isActive and THEME.Primary or THEME.Card
    Tab.Text = ""
    Tab.BorderSizePixel = 0
    CreateCorner(Tab, 8)
    
    if not IS_MOBILE then
        local ActiveIndicator = Instance.new("Frame", Tab)
        ActiveIndicator.Name = "Indicator"
        ActiveIndicator.Size = UDim2.new(0, 4, 0.6, 0)
        ActiveIndicator.Position = UDim2.new(0, 0, 0.2, 0)
        ActiveIndicator.BackgroundColor3 = THEME.Primary
        ActiveIndicator.BorderSizePixel = 0
        ActiveIndicator.Visible = isActive
        CreateCorner(ActiveIndicator, 2)
    end
    
    local Icon = Instance.new("TextLabel", Tab)
    Icon.Size = IS_MOBILE and UDim2.new(0, 25, 0, 25) or UDim2.new(0, 30, 0, 30)
    Icon.Position = IS_MOBILE and UDim2.new(0, 10, 0.5, -12.5) or UDim2.new(0, 12, 0.5, -15)
    Icon.BackgroundTransparency = 1
    Icon.Text = icon
    Icon.TextColor3 = isActive and THEME.Text or THEME.TextDim
    Icon.Font = Enum.Font.GothamBold
    Icon.TextSize = IS_MOBILE and 16 or 18
    
    local Label = Instance.new("TextLabel", Tab)
    Label.Size = IS_MOBILE and UDim2.new(1, -40, 1, 0) or UDim2.new(1, -50, 1, 0)
    Label.Position = IS_MOBILE and UDim2.new(0, 40, 0, 0) or UDim2.new(0, 50, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = isActive and THEME.Text or THEME.TextDim
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = IS_MOBILE and 12 or 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    Tab.MouseButton1Click:Connect(function()
        -- Hide all pages
        for _, p in pairs(PageContainer:GetChildren()) do
            if p:IsA("Frame") then p.Visible = false end
        end
        
        -- Update all tabs
        for _, t in pairs(TabContainer:GetChildren()) do
            if t:IsA("TextButton") then
                t.BackgroundColor3 = THEME.Card
                if t:FindFirstChild("Indicator") then
                    t.Indicator.Visible = false
                end
                for _, child in pairs(t:GetChildren()) do
                    if child:IsA("TextLabel") then
                        child.TextColor3 = THEME.TextDim
                    end
                end
            end
        end
        
        -- Activate clicked tab
        Tab.BackgroundColor3 = THEME.Primary
        if Tab:FindFirstChild("Indicator") then
            Tab.Indicator.Visible = true
        end
        Icon.TextColor3 = THEME.Text
        Label.TextColor3 = THEME.Text
        page.Visible = true
        CurrentTab = name
    end)
end

